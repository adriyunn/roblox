--!strict
-- netschemav3_test (About Fishing F1 cloud work, WS-N net v3; Cloud, 2026-10-07)
-- NetSchemaV3 under the Luau CLI: check() passes and mutated schema copies fail (duplicate id, unknown
-- state, unknown type, id outside 32..63, a C2S id in the S2C range, min above max); fieldProblem per
-- type and range; validate's missing / extra / order rules; allowed per state for three messages;
-- encode / decode basics, a scratch schema with an i16 field, every decode error; and the wire gate:
-- every vector of tests/fixtures/net_vectors_v3_data.luau (generated by Dev3-style tools/net_vectors_v3.py,
-- an independent Python encoder) encodes to the vector's hex and decodes back to the payload (f32 at
-- 1e-6), every invalid vector is rejected with the expected reason. Negative controls at the end.
-- Run from this folder: luau netschemav3_test.luau

local Stub = require("./RobloxStub")
local T = Stub.harness("netschemav3_test")
local N = require("../src/Fishing/Shared/NetSchemaV3")
local vectors: { any } = require("./fixtures/net_vectors_v3_data")

type Field = N.Field
type Messages = N.Messages

local function deepCopy(v: any): any
	if typeof(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

local function deepEq(a: any, b: any, tol: number): boolean
	if typeof(a) == "number" and typeof(b) == "number" then
		return math.abs(a - b) <= tol
	end
	if typeof(a) ~= typeof(b) then
		return false
	end
	if typeof(a) ~= "table" then
		return a == b
	end
	for k, v in a do
		if not deepEq(v, b[k], tol) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

-- decoded payload == vector payload, f32 fields at 1e-6, everything else exact; no extra keys
local function payloadEq(name: string, back: { [string]: any }, want: { [string]: any }): boolean
	local n = 0
	for _, f in N.MESSAGES[name].fields do
		n += 1
		if not deepEq(back[f.name], want[f.name], if f.type == "f32" then 1e-6 else 0) then
			return false
		end
	end
	local keys = 0
	for _ in back do
		keys += 1
	end
	return keys == n
end

local function schemaCopy(): Messages
	return deepCopy(N.MESSAGES)
end

-- ---------------------------------------------------------------- A: the schema's own check
T.check(N.check(), "A1 check() passes on the live schema")
local ids = N.ids()
T.eq(#ids, 13, "A2 thirteen message ids")
local sorted, inRange = true, true
for i, id in ids do
	sorted = sorted and (i == 1 or ids[i - 1] < id)
	inRange = inRange and id >= 32 and id <= 63
end
T.check(sorted and inRange, "A3 ids() is strictly ascending and every id is in 32..63")
T.eq(ids[1], 32, "A4 the first v3 id is 32 (nothing below it: v2 is untouched)")
T.eq(N.nameOf(32), "TackleMove", "A5 nameOf(32) is TackleMove")
T.eq(N.nameOf(31), nil, "A6 nameOf(31) is nil (a v2 id)")
local bad = schemaCopy()
bad.TackleDrop.id = 32
T.throws(function() N.check(bad) end, "id 32 already used by", "A7 negative control: a duplicate id fails check()")
bad = schemaCopy()
bad.Sell.states[1] = "Dancing"
T.throws(function() N.check(bad) end, "unknown state 'Dancing'", "A8 an unknown sender state fails")
bad = schemaCopy()
bad.TackleMove.fields[1].type = "u64" :: any
T.throws(function() N.check(bad) end, "unknown type 'u64'", "A9 an unknown field type fails")
bad = schemaCopy()
bad.ProfileReady.id = 64
T.throws(function() N.check(bad) end, "32..63", "A10 an id outside 32..63 fails")
bad = schemaCopy()
bad.TackleMove.id = 50
bad.SellResult.id = 40
T.throws(function() N.check(bad) end, "C2S ids are 32..47", "A11 a C2S id in the S2C range fails")
bad = schemaCopy()
bad.ProfileReady.states = { "Walking" }
T.throws(function() N.check(bad) end, "S2C message has none", "A12 an S2C message with sender states fails")
bad = schemaCopy()
bad.TackleMove.fields[3].min = 40
T.throws(function() N.check(bad) end, "min above max", "A13 min above max fails")
bad = schemaCopy()
bad.BuyGear.fields[2].maxLen = 300
T.throws(function() N.check(bad) end, "maxLen must be", "A14 a str maxLen over 255 fails")
bad = schemaCopy()
bad.Sell.rate.burst = 0
T.throws(function() N.check(bad) end, "burst >= 1", "A15 a C2S burst of 0 fails")
T.check(N.check(), "A16 the live schema is untouched by the mutated copies")

-- ---------------------------------------------------------------- B: fieldProblem per type and range
local function fp(f: Field, v: any): string?
	return N.fieldProblem(f, v)
end
local u8: Field = { name = "a", type = "u8", max = 3 }
T.eq(fp(u8, 2), nil, "B1 u8 2 in 0..3 is fine")
T.eq(fp(u8, 4), "a: out of range", "B2 u8 4 above max 3 is out of range")
T.eq(fp(u8, 1.5), "a: expected u8", "B3 u8 1.5 is not an integer")
T.eq(fp(u8, "2"), "a: expected u8", "B4 u8 '2' is not a number")
local u16: Field = { name = "b", type = "u16" }
T.eq(fp(u16, 65535), nil, "B5 u16 65535 is fine")
T.eq(fp(u16, 65536), "b: out of range", "B6 u16 65536 is out of range")
T.eq(fp(u16, -1), "b: out of range", "B7 u16 -1 is out of range")
local i16: Field = { name = "c", type = "i16" }
T.eq(fp(i16, -32768), nil, "B8 i16 -32768 is fine")
T.eq(fp(i16, 32767), nil, "B9 i16 32767 is fine")
T.eq(fp(i16, -32769), "c: out of range", "B10 i16 -32769 is out of range")
local u32: Field = { name = "d", type = "u32" }
T.eq(fp(u32, 4294967295), nil, "B11 u32 4294967295 is fine")
T.eq(fp(u32, 4294967296), "d: out of range", "B12 u32 4294967296 is out of range")
local f32: Field = { name = "e", type = "f32", min = -1, max = 1 }
T.eq(fp(f32, 0.5), nil, "B13 f32 0.5 in -1..1 is fine")
T.eq(fp(f32, 1.5), "e: out of range", "B14 f32 1.5 above max is out of range")
T.eq(fp(f32, 0 / 0), "e: expected f32", "B15 f32 NaN is not an f32")
T.eq(fp(f32, math.huge), "e: expected f32", "B16 f32 inf is not an f32")
T.eq(fp({ name = "e", type = "f32" }, 1e39), "e: out of range", "B17 f32 1e39 overflows float32")
T.eq(fp(f32, true), "e: expected f32", "B18 f32 true is not a number")
local bool: Field = { name = "f", type = "bool" }
T.eq(fp(bool, true), nil, "B19 bool true is fine")
T.eq(fp(bool, 1), "f: expected bool", "B20 bool 1 is not a bool")
local str: Field = { name = "g", type = "str", maxLen = 3 }
T.eq(fp(str, "abc"), nil, "B21 str 'abc' within maxLen 3 is fine")
T.eq(fp(str, ""), nil, "B22 the empty str is fine")
T.eq(fp(str, 5), "g: expected str", "B23 str 5 is not a string")
T.eq(fp(str, "abcd"), "g: too long", "B24 str 'abcd' over maxLen 3 is too long")
T.eq(fp(str, "\195\182"), "g: not ASCII", "B25 a UTF-8 o-umlaut is not ASCII")
T.eq(fp(str, "a\n"), "g: not ASCII", "B26 a control character is not ASCII")
local idsF: Field = { name = "h", type = "ids", maxLen = 2 }
T.eq(fp(idsF, { 1, 65535 }), nil, "B27 ids {1, 65535} is fine")
T.eq(fp(idsF, {}), nil, "B28 empty ids is fine at the schema level")
T.eq(fp(idsF, { 1, 2, 3 }), "h: too long", "B29 three ids over maxLen 2 is too long")
T.eq(fp(idsF, { 0 }), "h: bad id", "B30 id 0 is a bad id (ids start at 1)")
T.eq(fp(idsF, { 1.5 }), "h: bad id", "B31 id 1.5 is a bad id")
T.eq(fp(idsF, { "1" }), "h: bad id", "B32 id '1' is a bad id")
T.eq(fp(idsF, "1"), "h: expected ids", "B33 ids '1' is not an array")
T.eq(fp(idsF, { a = 1 }), "h: expected ids", "B34 ids with string keys is not an array")
local tbl: Field = { name = "i", type = "table", maxLen = 3 }
T.eq(fp(tbl, {}), nil, "B35 an empty table is fine")
T.eq(fp(tbl, { 1, 2 }), nil, "B36 an array of two numbers is fine (3 nodes)")
T.eq(fp(tbl, { a = { b = 1 } }), nil, "B37 a nested map is fine (3 nodes)")
T.eq(fp(tbl, { 1, 2, 3 }), "i: too long", "B38 four nodes over maxLen 3 is too long")
T.eq(fp(tbl, { 1, a = 1 }), "i: bad table", "B39 mixed array and string keys is a bad table")
T.eq(fp(tbl, { function() end }), "i: bad table", "B40 a function inside is a bad table")
T.eq(fp(tbl, { 0 / 0 }), "i: bad table", "B41 NaN inside is a bad table")
T.eq(fp(tbl, { "\195\182" }), "i: bad table", "B42 a non-ASCII string inside is a bad table")
T.eq(fp(tbl, { [2] = 1 }), "i: bad table", "B43 an array with a hole is a bad table")
T.eq(fp(tbl, 5), "i: expected table", "B44 table 5 is not a table")
local deep: any = 1
for _ = 1, 9 do
	deep = { deep }
end
T.eq(fp({ name = "i", type = "table" }, deep), "i: bad table", "B45 nine levels of nesting is a bad table (max 8)")
deep = 1
for _ = 1, 8 do
	deep = { deep }
end
T.eq(fp({ name = "i", type = "table" }, deep), nil, "B46 eight levels of nesting is fine")
T.throws(function() fp({ name = "z", type = "u64" :: any }, 1) end, "unknown field type", "B47 an unknown type errors")

-- ---------------------------------------------------------------- C: validate on messages
T.check(N.validate("TackleMove", { id = 3, rot = 1, x = 5, y = 2 }), "C1 a good TackleMove validates")
local ok, why = N.validate("TackleMove", { id = 3, rot = 1, x = 5 })
T.check(not ok and why == "missing y", "C2 a missing field is named")
ok, why = N.validate("TackleMove", { id = 3, rot = 1, x = 5, y = 2, z = 1 })
T.check(not ok and why == "unexpected z", "C3 an extra field is rejected")
ok, why = N.validate("TackleMove", { id = 3, rot = 1, x = 5, y = 2, z = 1, a = 1 })
T.check(not ok and why == "unexpected a", "C4 the first extra field in sorted order is named")
ok, why = N.validate("TackleMove", { id = "3", rot = 1, x = 5 })
T.check(not ok and why == "missing y", "C5 missing fields are reported before type problems")
ok, why = N.validate("Teleport", {})
T.check(not ok and why == "unknown message", "C6 an unknown message name")
ok, why = N.validate("TackleDrop", 5)
T.check(not ok and why == "payload must be a table", "C7 a non-table payload")
ok, why = N.validate("BuyGear", { kind = 1, id = "rod_c\195\182rbon" })
T.check(not ok and why == "id: not ASCII", "C8 a non-ASCII gear id is rejected")
T.check(N.validate("Sell", { ids = { 2, 5, 7 } }), "C9 a Sell of three ids validates")
T.check(N.validate("WorldSync", { clockTime = 7.25, dayN = 1, phase = 0, weather = 0, rain = 0, waveM = 0.02, sun = 0.3214 }), "C10 a WorldSync snapshot validates")

-- ---------------------------------------------------------------- D: allowed per state
local function allowedStates(name: string): string
	local out = {}
	for _, s in N.STATES do
		if N.allowed(name, s) then
			table.insert(out, s)
		end
	end
	return table.concat(out, ",")
end
T.eq(allowedStates("TackleMove"), "Walking,Holding", "D1 TackleMove only in Walking and Holding")
T.eq(allowedStates("Sell"), "Walking,Holding", "D2 Sell only in Walking and Holding")
T.eq(allowedStates("SetOption"), "Walking,Aiming,Presenting,Retrieving,Inspected,HookWindow,CatchScene,Holding", "D3 SetOption in every state but Flight and Hooked")
T.eq(allowedStates("TackleSync"), "", "D4 an S2C message is never a client request")
T.check(N.allowed("TackleMove", "Walking") and not N.allowed("TackleMove", "Aiming"), "D5 TackleMove: Walking yes, Aiming no")
T.check(not N.allowed("TackleMove", "Flight") and not N.allowed("TackleMove", "Hooked"), "D6 TackleMove: Flight no, Hooked no")
T.check(not N.allowed("SetOption", "Flight") and not N.allowed("SetOption", "Hooked"), "D7 SetOption: Flight no, Hooked no")
T.check(N.allowed("SetOption", "CatchScene") and N.allowed("SetOption", "HookWindow"), "D8 SetOption: CatchScene yes, HookWindow yes")
T.check(not N.allowed("TackleMove", "Dancing"), "D9 an unknown state is never allowed")
T.check(not N.allowed("Teleport", "Walking"), "D10 an unknown message is never allowed")

-- ---------------------------------------------------------------- E: encode / decode basics
local bytes = N.encode("TackleMove", { id = 3, rot = 1, x = 5, y = 2 })
T.eq(N.toHex(bytes), "200300010502", "E1 TackleMove{3,1,5,2} is 20 0300 01 05 02 (id first, u16 little-endian)")
T.eq(#bytes, 6, "E2 TackleMove is 6 bytes")
local name, back = N.decode(bytes)
T.check(name == "TackleMove" and back.id == 3 and back.rot == 1 and back.x == 5 and back.y == 2, "E3 decode gives the name and the fields back")
T.eq(N.toHex(N.encode("Sell", { ids = { 2, 5, 7 } })), "2203020005000700", "E4 Sell ids: u8 count then u16 items")
T.eq(N.toHex(N.encode("Sell", { ids = {} })), "2200", "E5 an empty Sell is 2 bytes")
T.eq(N.toHex(N.encode("BuyGear", { kind = 1, id = "rod" })), "230103726f64", "E6 str is u8 length + ASCII bytes")
T.eq(N.toHex(N.encode("SetOption", { key = 0, value = 0.1 })), "2500cdcccc3d", "E7 f32 via string.pack('<f') (0.1 = cd cc cc 3d)")
T.eq(N.toHex(N.encode("TackleMoveResult", { ok = true, reason = 5 })), "300105", "E8 bool is one byte 0/1")
T.eq(N.toHex(N.encode("BuyResult", { op = 0, ok = true, reason = 0, coins = 4294967295 })), "33000100ffffffff", "E9 u32 max is ff ff ff ff")
T.eq(N.toHex(N.encode("CatchLogSync", { log = {} })), "34060000", "E10 an empty table is an empty array (tag 6, count 0)")
T.eq(N.toHex(N.encode("CatchLogSync", { log = { b = 1, a = 0.5 } })), "3407020001006104000000000000e03f0100620301000000", "E11 map keys in byte order (u16 key length); 1 is i32 (tag 3), 0.5 is f64 (tag 4)")
T.eq(N.toHex(N.encode("CatchLogSync", { log = { 2147483648 } })), "3406010004000000000000e041", "E12 2^31 does not fit i32 so it is an f64")
T.eq(N.toHex(N.encode("CatchLogSync", { log = { true, false, "ab" } })), "3406030002010502006162", "E13 tagged bools and a str (u16 length) inside a table")
name, back = N.decode(N.encode("WorldSync", { clockTime = 7.25, dayN = 1, phase = 0, weather = 0, rain = 0, waveM = 0.02, sun = 0.3214 }))
T.check(name == "WorldSync" and math.abs(back.waveM - 0.02) < 1e-6 and math.abs(back.sun - 0.3214) < 1e-6 and back.clockTime == 7.25, "E14 f32 fields round-trip within 1e-6 (7.25 exactly)")
local sync = { w = 8, h = 6, nextId = 4, items = { { id = 1, kind = "fish", key = "trout", shape = { { 0, 0 }, { 1, 0 } }, rot = 0, x = 1, y = 1, data = { lengthM = 0.4 } } } }
name, back = N.decode(N.encode("TackleSync", sync))
T.check(name == "TackleSync" and deepEq(back, sync, 0), "E15 a TackleSync with a nested item round-trips exactly")
T.check(N.encode("TackleSync", sync) == N.encode("TackleSync", sync), "E16 encode is deterministic")
local scratch: Messages = { Probe = { id = 40, dir = "C2S", states = { "Walking" }, rate = { perS = 1, burst = 1 }, fields = { { name = "dz", type = "i16" }, { name = "n", type = "u8" } } } }
T.check(N.check(scratch), "E17 a scratch schema with an i16 field passes check()")
T.eq(N.toHex(N.encode("Probe", { dz = -2, n = 7 }, scratch)), "28feff07", "E18 i16 -2 is fe ff")
name, back = N.decode(N.fromHex("280080ff"), scratch)
T.check(name == "Probe" and back.dz == -32768 and back.n == 255, "E19 i16 00 80 decodes to -32768")
T.check(N.allowed("Probe", "Walking", scratch) and not N.allowed("Probe", "Holding", scratch), "E20 allowed() takes the scratch schema")
T.throws(function() N.encode("TackleMove", { id = 3, rot = 4, x = 5, y = 2 }) end, "TackleMove: rot: out of range", "E21 encode errors on a bad payload")
T.throws(function() N.decode("\99") end, "unknown message id 99", "E22 decode errors on an unknown id")
T.throws(function() N.decode("\32\3\0\1") end, "truncated at byte", "E23 decode errors on a truncated message")
T.throws(function() N.decode(N.encode("TackleDrop", { id = 1 }) .. "\0") end, "1 trailing bytes", "E24 decode errors on trailing bytes")
T.throws(function() N.decode("\48\2\0") end, "bad bool byte", "E25 decode errors on a bool byte of 2")
T.throws(function() N.decode("\52\9") end, "bad value tag", "E26 decode errors on an unknown value tag")
T.throws(function() N.decode("\35\1\5ro") end, "truncated at byte", "E27 decode errors on a str shorter than its length")
T.eq(N.fromHex(N.toHex("\0\1\255z")), "\0\1\255z", "E28 toHex / fromHex round-trip")
T.throws(function() N.fromHex("abc") end, "not a hex string", "E29 fromHex rejects an odd length")

-- ---------------------------------------------------------------- F: the vectors (the wire gate)
local nValid, nInvalid = 0, 0
local perMessage: { [string]: { number } } = {}
for i = 1, #vectors do
	local v: any = vectors[i]
	if v.valid then
		nValid += 1
		local vOk = N.validate(v.name, v.payload)
		local hex = if vOk then N.toHex(N.encode(v.name, v.payload)) else "(invalid)"
		local decOk = false
		if hex == v.hex then
			local dName, dBack = N.decode(N.fromHex(v.hex))
			decOk = dName == v.name and payloadEq(v.name, dBack, v.payload)
		end
		T.check(hex == v.hex and decOk, string.format("vector %d %s: encode gives the hex and decode gives the payload back", i, v.name)
			.. (if hex ~= v.hex then string.format("  (got %s, want %s)", string.sub(hex, 1, 40), string.sub(v.hex, 1, 40)) elseif not decOk then "  (decode differs)" else ""))
	else
		nInvalid += 1
		local vOk, vWhy = N.validate(v.name, v.payload)
		T.check(not vOk and vWhy == v.reason, string.format("vector %d %s: rejected with '%s'", i, v.name, v.reason) .. (if vWhy ~= v.reason then "  (got " .. tostring(vWhy) .. ")" else ""))
	end
	local pm = perMessage[v.name] or { 0, 0 }
	pm[if v.valid then 1 else 2] += 1
	perMessage[v.name] = pm
end
print(string.format("vectors: %d (%d valid, %d invalid)", #vectors, nValid, nInvalid))
T.check(#vectors >= 4 * 13 + 1 and nValid >= 39 and nInvalid >= 13, "F1 at least 4 vectors per message (" .. #vectors .. " total)")
local covered = true
for mName in N.MESSAGES do
	local pm = perMessage[mName]
	covered = covered and pm ~= nil and pm[1] >= 3 and pm[2] >= 1
end
T.check(covered, "F2 every message has >= 3 valid and >= 1 invalid vector")
local idsMatch = true
for _, v in vectors do
	if v.valid then
		local vName: string, vHex: string = v.name, v.hex
		idsMatch = idsMatch and tonumber(string.sub(vHex, 1, 2), 16) == N.MESSAGES[vName].id
	end
end
T.check(idsMatch, "F3 the first byte of every valid vector is the message id")

-- negative controls: the comparison can fail
local v1 = vectors[1]
local v1Hex: string = v1.hex
local flipped = string.sub(v1Hex, 1, -3) .. string.format("%02x", bit32.bxor(tonumber(string.sub(v1Hex, -2), 16) :: number, 1))
T.check(N.toHex(N.encode(v1.name, v1.payload)) ~= flipped, "N1 negative control: a flipped byte no longer matches the encode")
local moved = deepCopy(v1.payload)
moved.rot = (moved.rot + 1) % 4
T.check(N.toHex(N.encode(v1.name, moved)) ~= v1.hex, "N2 negative control: a changed payload gives other bytes")
local dName, dBack = N.decode(N.fromHex(v1.hex))
dBack.x += 1
T.check(dName == v1.name and not payloadEq(v1.name, dBack, v1.payload), "N3 negative control: payloadEq sees a changed field")

T.finish()
